{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "DAL node metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "id": 1,
      "title": "Storage failed",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "targets": [{ "refId": "A", "expr": "dal_storage_failed{instance=~\"$instance\"}", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 2,
      "title": "Diagnostic sample stale",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "targets": [{ "refId": "A", "expr": "dal_diagnostic_sample_stale{instance=~\"$instance\"}", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 3,
      "title": "Data filesystem free",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "targets": [{ "refId": "A", "expr": "dal_storage_filesystem_available_bytes{instance=~\"$instance\"} / dal_storage_filesystem_total_bytes{instance=~\"$instance\"}", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.4 }, { "color": "green", "value": 0.45 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 4,
      "title": "Client gateway p99",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.99, sum by (instance, le) (rate(dal_client_op_gateway_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.75 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 5,
      "title": "Raft term changes in 10 minutes",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "changes(dal_meta_current_term{instance=~\"$instance\"}[10m])", "legendFormat": "{{instance}} meta" },
        { "refId": "B", "expr": "changes(dal_partition_current_term{instance=~\"$instance\"}[10m])", "legendFormat": "{{instance}} partition {{partition}}" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 3 }] } }, "overrides": [] },
      "options": {}
    },
    {
      "id": 6,
      "title": "Leader quorum acknowledgement age",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "dal_meta_quorum_ack_age_milliseconds{instance=~\"$instance\"}", "legendFormat": "{{instance}} meta" },
        { "refId": "B", "expr": "dal_partition_quorum_ack_age_milliseconds{instance=~\"$instance\"}", "legendFormat": "{{instance}} partition {{partition}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10000 }] } }, "overrides": [] },
      "options": {}
    },
    {
      "id": 7,
      "title": "Materialization pending bytes",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "dal_partition_materialized_pending_bytes{instance=~\"$instance\"}", "legendFormat": "{{instance}} partition {{partition}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "options": {}
    },
    {
      "id": 8,
      "title": "Search outbox bytes",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "dal_search_outbox_bytes{instance=~\"$instance\"}", "legendFormat": "{{instance}} partition {{partition}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "options": {}
    },
    {
      "id": 9,
      "title": "Client operation reply outcomes per second",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "rate(dal_client_op_reply_outcomes_total{instance=~\"$instance\"}[$__rate_interval])", "legendFormat": "{{instance}} {{outcome}}" }],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "options": {}
    },
    {
      "id": 10,
      "title": "Client gateway latency quantiles",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (instance, le) (rate(dal_client_op_gateway_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "{{instance}} p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (instance, le) (rate(dal_client_op_gateway_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "{{instance}} p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (instance, le) (rate(dal_client_op_gateway_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "{{instance}} p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": {}
    },
    {
      "id": 11,
      "title": "Partition recovery readiness",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 29, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "dal_partition_recovery_ready{instance=~\"$instance\"}", "legendFormat": "{{instance}} partition {{partition}}" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": {}
    },
    {
      "id": 12,
      "title": "Oldest materialization work",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 29, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "dal_partition_oldest_pending_milliseconds{instance=~\"$instance\"}", "legendFormat": "{{instance}} partition {{partition}}" }],
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60000 }] } }, "overrides": [] },
      "options": {}
    },
    {
      "id": 13,
      "title": "Diagnostic log drops in 5 minutes",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 37, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "increase(dal_log_dropped_lines_total{instance=~\"$instance\"}[5m])", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] } }, "overrides": [] },
      "options": {}
    },
    {
      "id": 14,
      "title": "Authorization denials in 5 minutes",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 37, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "increase(dal_authorization_denials_total{instance=~\"$instance\"}[5m])", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 20 }] } }, "overrides": [] },
      "options": {}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["dal", "operations"],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Node",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(dal_storage_failed, instance)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "DAL service overview",
  "uid": "dal-service-overview",
  "version": 1
}
